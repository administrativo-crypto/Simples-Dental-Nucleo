{
  "name": "simples-dental-login",
  "version": "1.0.0",
  "description": "Automacao de login no Simples Dental usando Playwright + TypeScript (Clean Architecture)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "login": "ts-node src/main.ts",
    "postinstall": "playwright install chromium"
  },
  "keywords": ["playwright", "simples-dental", "clean-architecture", "typescript"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "playwright": "^1.47.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
