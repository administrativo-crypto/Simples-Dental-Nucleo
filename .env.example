# URL de login do Simples Dental
SIMPLES_DENTAL_LOGIN_URL=https://app.simplesdental.com/

# Credenciais de acesso
SIMPLES_DENTAL_USERNAME=seu_usuario_ou_email
SIMPLES_DENTAL_PASSWORD=sua_senha

# Configuracao do navegador (Playwright)
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=0
BROWSER_TIMEOUT_MS=30000
# chromium | firefox | webkit
BROWSER_TYPE=chromium

# Caminho para salvar o estado de sessao (cookies) apos login
STORAGE_STATE_PATH=./storage/session.json

# Limite opcional de pacientes a processar (deixe vazio para processar todos).
# Recomendado usar um numero baixo (ex: 3) durante os testes iniciais.
SIMPLES_DENTAL_MAX_PATIENTS=3

# Nivel de log: error | warn | info | debug
LOG_LEVEL=info
LOG_DIR=./logs

# ===== Sincronização com o Lovable (RECOMENDADO — mais simples) =====
# Envia os dados via HTTP para uma Edge Function criada dentro do próprio
# projeto Lovable. Não exige service_role key nem migração de backend.
ENABLE_LOVABLE_HTTP_SYNC=false

# URL da Edge Function criada no Lovable (Cloud > Edge functions)
LOVABLE_SYNC_URL=https://SEU_PROJETO.supabase.co/functions/v1/sync-patients

# Chave secreta combinada com o secret SYNC_API_KEY configurado no Lovable
LOVABLE_SYNC_API_KEY=

# ===== Sprint 03 (alternativa): sincronizacao direta com Supabase =====
# Só use isto se tiver um projeto Supabase PRÓPRIO conectado (não Lovable
# Cloud gerenciado). Se ENABLE_LOVABLE_HTTP_SYNC=true, esta seção é ignorada.
# Defina como "true" para habilitar a gravacao dos dados no Supabase.
# Enquanto for "false", o robo apenas navega e exibe o JSON no console (Sprint 02).
ENABLE_SUPABASE_SYNC=false

# URL do projeto Supabase (Project Settings -> API)
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Service Role Key (Project Settings -> API -> service_role secret).
# NUNCA use a "anon" key aqui — a service_role e necessaria para
# gravar dados a partir de um script de backend, e ignora RLS.
# Mantenha este valor em segredo (nunca commite o .env real).
SUPABASE_SERVICE_KEY=sua_service_role_key
